# ===================================================
# J.A.R.V.I.S. — Archivo de Configuración de Entorno
# ===================================================
# Copia este archivo como .env antes de levantar Docker:
#   cp .env.example .env

# Puerto en el que se expondrá Jarvis en la máquina host (por defecto: 80)
JARVIS_PORT=80

# URL del Webhook de producción de n8n para procesar comandos de voz y texto
VITE_N8N_WEBHOOK_URL=https://n8n.nexotechx.com/webhook/1faaf855-bd93-4b57-a298-8bdd00e419da

# Clave API de ElevenLabs (Opcional si se configura desde el panel de ajustes en la UI)
VITE_ELEVENLABS_API_KEY=

# ID de la Voz de ElevenLabs (Por defecto voz Jarvis: DMyrgzQFny3JI1Y1paM5)
VITE_ELEVENLABS_VOICE_ID=DMyrgzQFny3JI1Y1paM5
